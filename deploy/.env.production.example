# Black Dog Store — variables de PRODUCCIÓN.
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# `deploy/.env.production` NO se sube al repositorio (está en .gitignore).
# Ningún valor de este archivo de ejemplo es un secreto real.

# --- Dominio ---------------------------------------------------------------
# Sin https:// y sin www. Ejemplo: mitienda.example
# De aquí salen, en docker-compose.prod.yml, ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS,
# CSRF_TRUSTED_ORIGINS, FRONTEND_URL y CHECKOUT_RETURN_URL. El backend no
# arranca si las dos últimas faltan o apuntan a localhost.
SITE_DOMAIN=

# --- Secretos (generar; no reutilizar los de desarrollo) --------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_USER=blackdog
POSTGRES_DB=blackdog

# --- Tienda ----------------------------------------------------------------
# Empresa cuya tienda se muestra en el dominio.
DEFAULT_STOREFRONT_COMPANY_SLUG=black-dog-store
# Nombre en los correos de cuenta (verificación, contraseña). Vacío = sin marca.
PLATFORM_NAME=
# Hosts cuyas imágenes de producto puede optimizar la web, separados por coma.
# Vacío = no se muestra ninguna imagen remota de producto. Cambiarlo exige
# reconstruir el frontend.
NEXT_PUBLIC_IMAGE_HOSTS=

# --- Correo (obligatorio para invitar personal y recuperar contraseñas) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Quién recibe el aviso de cada pedido pagado.
ORDER_NOTIFICATION_EMAIL=
REQUIRE_EMAIL_VERIFICATION=1

# --- Pagos en línea (Izipay) ------------------------------------------------
# Sin estas claves el catálogo y el carrito funcionan, pero no se puede cobrar
# en línea. `sandbox` hasta que Izipay entregue las credenciales de producción.
PAYMENT_PROVIDER=izipay
IZIPAY_ENV=sandbox
IZIPAY_MERCHANT_CODE=
IZIPAY_PUBLIC_KEY=
IZIPAY_API_KEY=
IZIPAY_HASH_KEY=
IZIPAY_TOKEN_URL=
IZIPAY_CURRENCY=PEN
# https://<SITE_DOMAIN>/api/payments/izipay/notification/
IZIPAY_IPN_URL=

# Sólo si PAYMENT_PROVIDER=micuentaweb (el otro producto de Izipay: «Mi Cuenta
# Web», API REST V4). Se usa UNO de los dos, nunca ambos. TEST o PRODUCCIÓN lo
# decide el par de claves que se pega; no se mezclan.
MICUENTAWEB_SHOP_ID=
MICUENTAWEB_PUBLIC_KEY=
MICUENTAWEB_PASSWORD=
MICUENTAWEB_HMAC_KEY=
MICUENTAWEB_API_URL=https://api.micuentaweb.pe
MICUENTAWEB_CURRENCY=PEN
# https://<SITE_DOMAIN>/api/payments/micuentaweb/notification/
MICUENTAWEB_IPN_URL=

# --- Evidencias del servicio técnico (privadas) ------------------------------
# `filesystem` las guarda en el volumen `evidence` del servidor; nunca se sirven
# por una URL pública, sólo a través de la API con permiso.
EVIDENCE_STORAGE_BACKEND=filesystem
# Con `s3` van a un almacenamiento compatible con S3. Las claves son secretos.
# EVIDENCE_STORAGE_BUCKET=
# EVIDENCE_STORAGE_ENDPOINT_URL=
# EVIDENCE_STORAGE_ACCESS_KEY_ID=
# EVIDENCE_STORAGE_SECRET_ACCESS_KEY=
# EVIDENCE_STORAGE_REGION=auto

# --- «Continuar con Google» ---------------------------------------------------
# El ID de cliente OAuth (Google Identity Services). Es público. Vacío = el botón
# no se ofrece. No hay secreto de cliente: el flujo de ID token no lo usa.
# En Google Cloud, el origen autorizado es el dominio público de la tienda.
GOOGLE_OAUTH_CLIENT_ID=

# --- Avisos por WhatsApp (API oficial de WhatsApp Business) ------------------
# Apagado hasta que cada empresa tenga su número, sus plantillas aprobadas y
# sus credenciales. `cloud_api` usa la Cloud API de Meta; `disabled` no envía.
WHATSAPP_PROVIDER=disabled
# WHATSAPP_GRAPH_API_VERSION=v21.0
# Con `0`, los mensajes los envía sólo el temporizador que ejecuta
# `python manage.py send_pending_notifications` (recomendado: cada minuto).
# WHATSAPP_SEND_INLINE=1
# Las credenciales de CADA empresa son variables con prefijo WHATSAPP_ —secretos:
# nunca en Git— y se enlazan con `python manage.py configure_whatsapp <empresa>`:
# WHATSAPP_TOKEN_<EMPRESA>=
# WHATSAPP_SECRET_<EMPRESA>=
# WHATSAPP_VERIFY_<EMPRESA>=

# --- Registro ---------------------------------------------------------------
# Nivel del registro, a stderr (`docker compose logs backend`). INFO por defecto.
# DJANGO_LOG_LEVEL=INFO

# --- Facturación electrónica (SUNAT) ----------------------------------------
# Apagada. Encenderla es una fase aparte con certificado y credenciales SOL.
FISCAL_ENABLED=0
