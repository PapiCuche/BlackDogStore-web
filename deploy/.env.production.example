# Black Dog Store — variables de PRODUCCIÓN.
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# `deploy/.env.production` NO se sube al repositorio (está en .gitignore).
# Ningún valor de este archivo de ejemplo es un secreto real.

# --- Dominio ---------------------------------------------------------------
# Sin https:// y sin www. Ejemplo: blackdogstore.pe
SITE_DOMAIN=

# --- Secretos (generar; no reutilizar los de desarrollo) --------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_USER=blackdog
POSTGRES_DB=blackdog

# --- Tienda ----------------------------------------------------------------
# Empresa cuya tienda se muestra en el dominio.
DEFAULT_STOREFRONT_COMPANY_SLUG=black-dog-store
# Nombre en los correos de cuenta (verificación, contraseña). Vacío = sin marca.
PLATFORM_NAME=
# Hosts cuyas imágenes de producto puede optimizar la web, separados por coma.
# Vacío = no se muestra ninguna imagen remota de producto. Cambiarlo exige
# reconstruir el frontend.
NEXT_PUBLIC_IMAGE_HOSTS=

# --- Correo (obligatorio para invitar personal y recuperar contraseñas) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Quién recibe el aviso de cada pedido pagado.
ORDER_NOTIFICATION_EMAIL=
REQUIRE_EMAIL_VERIFICATION=1

# --- Pagos en línea (Izipay) ------------------------------------------------
# Sin estas claves el catálogo y el carrito funcionan, pero no se puede cobrar
# en línea. `sandbox` hasta que Izipay entregue las credenciales de producción.
PAYMENT_PROVIDER=izipay
IZIPAY_ENV=sandbox
IZIPAY_MERCHANT_CODE=
IZIPAY_PUBLIC_KEY=
IZIPAY_API_KEY=
IZIPAY_HASH_KEY=
IZIPAY_TOKEN_URL=
IZIPAY_CURRENCY=PEN
# https://<SITE_DOMAIN>/api/payments/izipay/notification/
IZIPAY_IPN_URL=

# --- Evidencias del servicio técnico ----------------------------------------
# `filesystem` las guarda en el volumen `evidence` del servidor.
EVIDENCE_STORAGE_BACKEND=filesystem

# --- Facturación electrónica (SUNAT) ----------------------------------------
# Apagada. Encenderla es una fase aparte con certificado y credenciales SOL.
FISCAL_ENABLED=0
