# Black Dog Store — tareas programadas de PRODUCCIÓN.
#
# Se instalan en el `crontab` del usuario que administra el servidor:
#
#   sed "s|/ruta/al/repositorio|$(pwd)|g" deploy/crontab.example | crontab -
#
# (ese comando REEMPLAZA el crontab de ese usuario; si ya tiene otras tareas,
# añade estas líneas a mano con `crontab -e`).
#
# No hace falta ningún servicio más: las ejecuta el contenedor `backend`, que ya
# está encendido. Cada tarea escribe en su archivo dentro de `backups/`.
# Qué hace cada una y cómo comprobarla: docs/despliegue-produccion.md §6.

# Si el servidor puede enviar correo, cron manda aquí lo que imprima una tarea
# que falla. Sin correo, los avisos quedan en backups/healthcheck.log.
# MAILTO=alguien@example.com

REPO=/ruta/al/repositorio
C=docker compose -f docker-compose.prod.yml --env-file deploy/.env.production

# Copia de seguridad: base de datos y archivos subidos. Cada noche.
15 3 * * *   cd $REPO && mkdir -p backups && sh deploy/backup.sh >> backups/backup.log 2>&1

# Sesiones caducadas. Cada noche, después de la copia.
45 3 * * *   cd $REPO && mkdir -p backups && $C exec -T backend python manage.py flushexpiredtokens >> backups/flushexpiredtokens.log 2>&1

# Imágenes subidas que nadie llegó a usar (incluye las de una carga masiva sin aplicar).
55 3 * * *   cd $REPO && mkdir -p backups && $C exec -T backend python manage.py cleanup_storefront_images >> backups/cleanup_storefront_images.log 2>&1

# Avisos por WhatsApp pendientes o por reintentar. Cada minuto. Con
# WHATSAPP_PROVIDER=disabled no hay nada que enviar y la línea puede quitarse.
* * * * *    cd $REPO && mkdir -p backups && $C exec -T backend python manage.py send_pending_notifications >> backups/send_pending_notifications.log 2>&1

# Conversiones de compra que Google Analytics, Meta o TikTok no aceptaron a la
# primera. Cada cinco minutos. Sin ninguna de esas integraciones activa con envío
# desde el servidor no hay nada que enviar y termina al momento.
*/5 * * * *  cd $REPO && mkdir -p backups && $C exec -T backend python manage.py send_pending_conversions >> backups/send_pending_conversions.log 2>&1

# Pagos que siguen sin notificación de la pasarela: se le pregunta a ella
# (`Order/Get`, sólo con «Mi Cuenta Web» activo). Cada cinco minutos, no más
# seguido: la pasarela recomienda una consulta por minuto como mucho. Con el otro
# producto de Izipay, o sin pagos esperando, no hace nada y termina al momento.
*/5 * * * *  cd $REPO && mkdir -p backups && $C exec -T backend python manage.py reconcile_payments >> backups/reconcile_payments.log 2>&1

# DC2: equipos apartados en carritos web cuyo plazo venció, de vuelta al
# estante (la tienda también lo hace al leer; esto barre lo que nadie leyó).
# Cada cinco minutos. SI SE VUELVE A UNA VERSIÓN ANTERIOR A DC2, QUITA ESTA
# LÍNEA: esa versión no tiene este comando (docs/despliegue-produccion.md §7).
*/5 * * * *  cd $REPO && mkdir -p backups && $C exec -T backend python manage.py release_expired_unit_holds >> backups/release_expired_unit_holds.log 2>&1

# DC3: ofertas de proveedor cuya vigencia terminó, desactivadas (con su línea de
# auditoría). La tienda ya no vende contra ellas aunque esto no corra; sólo
# ordena el panel. Una vez por hora. SI SE VUELVE A UNA VERSIÓN ANTERIOR A DC3,
# QUITA ESTA LÍNEA: esa versión no tiene este comando (docs/despliegue-produccion.md §7).
17 * * * *  cd $REPO && mkdir -p backups && $C exec -T backend python manage.py expire_supplier_offers >> backups/expire_supplier_offers.log 2>&1

# FIN-B1: períodos de los pagos fijos que vencen en los próximos 35 días
# (idempotente; nunca cierra ni borra lo vencido). Una vez por hora. SI SE VUELVE
# A UNA VERSIÓN ANTERIOR A FIN-B1, QUITA ESTA LÍNEA: esa versión no tiene este comando.
# FIN-REMIND-01: si instalas la línea de abajo (`run_finance_schedule`), ésta sobra: aquélla ya genera los períodos.
23 * * * *  cd $REPO && mkdir -p backups && $C exec -T backend python manage.py generate_finance_obligations >> backups/generate_finance_obligations.log 2>&1

# FIN-REMIND-01: pasada financiera de cada empresa en SU fecha local: genera los períodos de los pagos fijos y envía los
# recordatorios internos (campana; correo sólo si la empresa lo activó). Idempotente y segura si corre dos veces a la
# vez; no registra pagos, no cierra ni anula nada y no envía WhatsApp. Cada 15 minutos. `ops_status` avisa si pasa
# más de 1 hora sin pasada. SI SE VUELVE A UNA VERSIÓN ANTERIOR A FIN-REMIND-01, QUITA ESTA LÍNEA y deja la de arriba.
*/15 * * * * cd $REPO && mkdir -p backups && flock -n /tmp/bds-run-finance-schedule.lock $C exec -T backend python manage.py run_finance_schedule >> backups/run_finance_schedule.log 2>&1

# Estado: contenedores, tienda, base, pagos, WhatsApp, copia y disco. Cada 15
# minutos. No imprime nada si todo está bien; si algo necesita atención lo
# escribe (y cron lo envía a MAILTO). El registro completo queda en el archivo.
*/15 * * * * cd $REPO && mkdir -p backups && sh deploy/healthcheck.sh > backups/healthcheck.last 2>&1; rc=$?; cat backups/healthcheck.last >> backups/healthcheck.log; [ $rc -eq 0 ] || grep '^ATENCIÓN' backups/healthcheck.last
