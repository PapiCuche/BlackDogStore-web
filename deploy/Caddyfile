# Black Dog Store — borde HTTPS.
#
# Caddy pide y renueva solo el certificado de Let's Encrypt para SITE_DOMAIN y
# redirige el puerto 80 a HTTPS. Requisito: el registro DNS del dominio tiene
# que apuntar ya a este servidor y los puertos 80 y 443 estar abiertos.
#
# CADDY_TLS_DIRECTIVE va vacío en producción (certificado público). Sólo para
# ensayar en local, sin dominio que validar, vale `tls internal`.
(tls_mode) {
	{$CADDY_TLS_DIRECTIVE}
}

# TIEMPOS DE ESPERA (PROXY-TIMEOUTS). Sin ellos, quien abre una conexión y no
# envía nada, o envía un byte por minuto, la conserva el tiempo que quiera.
#
#   read_header  lo que tarda una petición en decir qué pide;
#   read_body    lo que puede tardar su cuerpo: una carga masiva de 111 MiB por
#                una conexión doméstica lenta cabe; un cuerpo que no avanza, no;
#   idle         una conexión abierta sin ninguna petición.
#
# LO QUE CADDY ESCRIBE EN SU PROPIO REGISTRO (LOG-REDACT). No lleva registro de
# acceso, pero cuando no alcanza a una aplicación anota la petición que estaba
# atendiendo, con su dirección entera y su referente: el enlace de seguimiento
# de una reparación, o lo que alguien escribió en un buscador. Se quitan esos
# dos campos; el método, el host y el error siguen ahí.
{
	servers {
		timeouts {
			read_header 15s
			read_body 15m
			idle 2m
		}
	}
	log default {
		format filter {
			fields {
				request>uri delete
				request>headers>Referer delete
			}
		}
	}
}

{$SITE_DOMAIN} {
	import tls_mode
	encode zstd gzip

	# HSTS lo pone el borde, que es quien termina TLS. Las otras dos llevan `?`:
	# sólo se añaden si la aplicación no envió la suya. Next y Django ya las
	# envían, y hay páginas que piden una política más estricta —las que reciben
	# un token en la URL responden `Referrer-Policy: no-referrer`—; pisarla
	# aquí la debilitaría.
	header {
		Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	# LA API VA DIRECTA A DJANGO.
	#
	# El proxy interno de Next (`app/api/[...path]`) descarta a propósito las
	# cabeceras de identidad del cliente. Detrás de él, Django vería a todos los
	# visitantes con la misma IP y compartirían los límites de peticiones: cinco
	# inicios de sesión por minuto PARA TODA LA TIENDA. Aquí Caddy escribe la IP
	# real en X-Forwarded-For —ignorando la que envíe el cliente— y Django la
	# lee con TRUSTED_PROXY_COUNT=1.
	#
	# Sólo `/api/*` llega a Django. El admin de Django no existe en producción:
	# con DEBUG=0 el backend no registra esa ruta.
	@api path /api/*
	handle @api {
		# El frontend llama sin barra final y Django las exige. Es lo mismo que
		# hace el proxy de Next: añadirla antes de reenviar.
		@noslash not path */
		rewrite @noslash {path}/

		# TAMAÑO MÁXIMO DEL CUERPO, POR RUTA (BODY-LIMIT).
		#
		# Ninguna petición cruza sin tope. Cada ruta que recibe archivos admite
		# lo que su pantalla acepta más el sobre del formulario; el resto, 1 MiB.
		# Lo que exceda se corta aquí con 413 y no llega entero a Django.
		#
		# ESTA TABLA ES LA DE `backend/store/request_limits.py`, escrita dos
		# veces porque este archivo no puede leer Python. La prueba
		# `store.test_request_limits` falla si dejan de coincidir: quien suba un
		# límite en un sitio tiene que subirlo en el otro.
		@limit_payment_notification path_regexp ^/api/payments/(izipay|micuentaweb)/notification/?$
		handle @limit_payment_notification {
			request_body {
				max_size 128KiB
			}
			reverse_proxy backend:8000 {
				request_buffers 128KiB
			}
		}

		@limit_whatsapp_webhook path_regexp ^/api/v1/webhooks/whatsapp/[^/]+/?$
		handle @limit_whatsapp_webhook {
			request_body {
				max_size 3MiB
			}
			reverse_proxy backend:8000 {
				request_buffers 3MiB
			}
		}

		@limit_image path_regexp ^/api/admin/(storefront/images|products/[0-9]+/images)/?$
		handle @limit_image {
			request_body {
				max_size 9MiB
			}
			reverse_proxy backend:8000
		}

		@limit_evidence path_regexp ^/api/v1/internal/[^/]+/service/orders/[0-9]+/evidence/?$
		handle @limit_evidence {
			request_body {
				max_size 26MiB
			}
			reverse_proxy backend:8000
		}

		@limit_workbook path_regexp ^/api/admin/(imports/inspect|inventory/import/preview|inventory/units/import/preview)/?$
		handle @limit_workbook {
			request_body {
				max_size 11MiB
			}
			reverse_proxy backend:8000
		}

		@limit_product_import path_regexp ^/api/admin/products/import/preview/?$
		handle @limit_product_import {
			request_body {
				max_size 111MiB
			}
			reverse_proxy backend:8000
		}

		# El resto de la API. Además del tope, Caddy LEE EL CUERPO ENTERO antes
		# de pasar la petición (SLOW-BODY): Django atiende con ocho hilos, y un
		# cuerpo que llega a cuentagotas ocuparía uno mientras dure. Con nueve
		# peticiones así, sin sesión, la API dejaba de responder.
		#
		# Lo mismo en las dos rutas de arriba que reciben llamadas de fuera —la
		# notificación de pago y el webhook de WhatsApp—, cuya vista lee el
		# cuerpo sin que nadie haya probado quién es. En las de archivos no: el
		# cuerpo es grande, y Django no lo lee hasta haber comprobado la sesión,
		# la cabecera CSRF y el permiso.
		handle {
			request_body {
				max_size 1MiB
			}
			reverse_proxy backend:8000 {
				request_buffers 1MiB
			}
		}
	}

	handle {
		request_body {
			max_size 1MiB
		}
		reverse_proxy frontend:3000
	}
}

www.{$SITE_DOMAIN} {
	import tls_mode
	redir https://{$SITE_DOMAIN}{uri} permanent
}
