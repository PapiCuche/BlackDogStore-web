# ============================================================
# BLACK DOG STORE — Example environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit your real .env to version control.
# ============================================================

# ---- Django core ----
# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-dev-only

# Set to 0 (False) in production
DEBUG=1

# Comma-separated list of allowed hostnames
# Dev: localhost,127.0.0.1
# Prod: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Proxies de confianza (Fase 0.3 / P0-B) ----
# Cuántos proxies delante de Django pueden ser creídos cuando dicen quién es el
# cliente. Decide la IP que se usa para rate limiting y para el registro de
# auditoría.
#
#   0  (por defecto)  Se ignora X-Forwarded-For por completo; el cliente es
#                     REMOTE_ADDR, el par que abrió el socket.
#   N  > 0            EXACTAMENTE N proxies añaden su entrada a
#                     X-Forwarded-For, y el cliente es la entrada N-ésima
#                     contando desde la DERECHA.
#
# ATENCIÓN: poner 1 porque "hay un proxy delante" es la configuración peligrosa
# si ese proxy NO añade nada a X-Forwarded-For. En ese caso la entrada más a la
# derecha es la que escribió el propio cliente, y la variable que debía
# establecer la confianza se la entrega al atacante.
#
# Sólo súbelo de 0 cuando el edge (nginx / CDN / balanceador):
#   1. ELIMINE el X-Forwarded-For que llegue del cliente, y
#   2. AÑADA la IP real del par que se conectó.
#
# Con 0 y Django detrás de un proxy no declarado, todos los clientes comparten
# el mismo contador de rate limit (el del proxy). Es demasiado estricto, nunca
# evitable.
TRUSTED_PROXY_COUNT=0

# ---- Database ----
# Dev: SQLite is used automatically when DATABASE_URL is not set
# Prod (Docker): postgres://postgres:postgres@db:5432/blackdog
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blackdog

# ---- CORS (required only when DEBUG=0) ----
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Pagos: Izipay (Fase 0.3 / P0-F) ----
#
# TODOS LOS VALORES DE ABAJO SON MARCADORES. Las credenciales reales se sacan
# del panel de comercio de Izipay (sección Desarrolladores) y NUNCA se
# commitean, ni siquiera las de sandbox.
PAYMENT_PROVIDER=izipay

# sandbox | production. EXPLÍCITO A PROPÓSITO: no se deduce de DEBUG. Un
# servidor de staging con DEBUG=0 no es producción, y deducirlo sería la forma
# de empezar a cobrar de verdad sin que nadie lo decidiera.
IZIPAY_ENV=sandbox

# Públicos: Izipay los documenta como aptos para el navegador y el SDK los
# necesita ahí.
IZIPAY_MERCHANT_CODE=xxxxxxx
IZIPAY_PUBLIC_KEY=pk_placeholder

# SECRETOS: sólo backend. La API key emite tokens de sesión; la clave hash
# valida la firma de las notificaciones. Cualquiera de las dos en el navegador
# es toda la integración.
IZIPAY_API_KEY=placeholder-api-key
IZIPAY_HASH_KEY=placeholder-hash-key

# Endpoint del API de token de sesión del entorno elegido. SIN VALOR POR
# DEFECTO en el código: la referencia REST de Izipay se renderiza en el
# navegador y la autoridad es el panel del comercio, así que poner una URL
# adivinada sería inventar un endpoint. Vacío falla cerrado y nombra la
# variable.
IZIPAY_TOKEN_URL=https://<host-de-tu-panel-izipay>/<ruta-del-token-de-sesion>

# Moneda del cobro. Debe coincidir con los precios mostrados. Perú: PEN.
IZIPAY_CURRENCY=PEN

# URL pública y absoluta de NUESTRO endpoint de notificación, entregada a
# Izipay en cada transacción. Vacío = la URL se configura en el panel; en
# cualquier caso la seguridad del endpoint es su firma, no la ruta.
IZIPAY_IPN_URL=https://yourdomain.com/api/payments/izipay/notification/

# Dominio del frontend al que vuelve el comprador tras pagar.
CHECKOUT_RETURN_URL=http://localhost:3000

# ---- Frontend: hosts de imágenes remotas (Fase 0.3 / P0-A) ----
# Lista separada por comas de los dominios HTTPS desde los que `next/image`
# puede optimizar imágenes. Se admite `*.` para subdominios de un dominio propio.
#
# Antes esto era `hostname: "**"`, es decir CUALQUIER host de internet, lo que
# convertía /_next/image en un proxy de imágenes abierto: cualquiera podía hacer
# que el servidor descargara cualquier URL, con la IP y el ancho de banda del
# servidor. Ahora la lista es explícita.
#
# Si se deja vacía NO se permite ningún host remoto (sólo localhost en
# desarrollo). Es deliberado: una imagen que no carga se ve y se arregla; un
# comodín restaurado en silencio, no.
#
# Ejemplo: NEXT_PUBLIC_IMAGE_HOSTS=cdn.tudominio.com,*.cloudfront.net
NEXT_PUBLIC_IMAGE_HOSTS=

# ---- JWT Cookies (Phase 2.1) ----
# Cookie names (defaults shown — only change if you have naming conflicts)
# JWT_COOKIE_ACCESS_NAME=blackdog_access
# JWT_COOKIE_REFRESH_NAME=blackdog_refresh
# SameSite policy: Lax (recommended), Strict, or None (requires Secure=True + HTTPS)
# JWT_COOKIE_SAMESITE=Lax

# ---- CSRF Trusted Origins (required when frontend and backend are on different origins) ----
# Dev default: http://localhost:3000,http://localhost:3002
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ---- Email (Phase 2.3 / 4.1) ----
# Development: emails go to console stdout (no SMTP required)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Transport-level sender. PLATFORM configuration: the SMTP credentials behind
# it belong to the operator. The identity INSIDE each order email is per
# tenant, from CompanySettings — see docs/saas-multiempresa.md.
DEFAULT_FROM_EMAIL=no-reply@localhost

# Frontend URL used to build links in emails (e.g. verification, reset, admin panel)
FRONTEND_URL=http://localhost:3000

# Set to True to require email verification before login
# When True: new users are inactive until they click the link in the verification email
REQUIRE_EMAIL_VERIFICATION=False

# Internal recipient for new-sale notifications (Phase 4.1).
# Leave empty to disable internal notifications.
# DEPRECATED as a recipient since Phase 3. Each company names its own address
# in CompanySettings.order_notification_email, and there is NO fallback to
# this one: it holds a single address, so falling back would announce a second
# tenant's sales in whoever owns it's inbox. Kept only so migration 0028 can
# copy it into the pilot company's settings during the upgrade.
# ORDER_NOTIFICATION_EMAIL=ventas@example.com

# ---- Platform identity (Phase 3) ----
# The SaaS operator's own name, used ONLY on account-security emails
# (verification, password reset). Those concern a global User account, not a
# purchase from any one tenant. Empty means those emails carry no brand name,
# which is the honest default for a platform that may be forked.
# PLATFORM_NAME=Mi Plataforma

# ---- SMTP (production only — set EMAIL_BACKEND to smtp to use) ----
# Brevo (formerly Sendinblue) example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_brevo_smtp_user
# EMAIL_HOST_PASSWORD=your_brevo_smtp_key
# EMAIL_USE_TLS=True
#
# SendGrid example:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key
#
# Gmail (for testing only — not recommended for production):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your_gmail@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password  (16-char App Password from Google Account)

# ---- HTTPS (production only, ignored when DEBUG=1) ----
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000

# --- Storefront multiempresa (Fase 2B) ---
# Slug de la empresa cuyo catálogo sirve este storefront cuando el host no
# identifica un tenant (despliegue de una sola tienda).
# Con varias empresas y sin subdominios configurados, esto es OBLIGATORIO:
# sin él el catálogo público queda vacío, que es el fallo seguro.
DEFAULT_STOREFRONT_COMPANY_SLUG=

# --- Ubicación del stock histórico (Fase 2D, migración 0025) ---
# NO es una variable de entorno: es un dict en backend/settings.py
# (INVENTORY_MIGRATION_BRANCHES). Se documenta aquí porque es lo primero que hay
# que mirar si `manage.py migrate` se detiene al actualizar una instalación con
# datos.
#
# La 0025 reparte entre sucursales el stock que antes era una sola cifra por
# producto. Con UNA sucursal activa lo resuelve sola y no hace falta tocar nada.
# Con VARIAS, se detiene y pide el mapa, en lugar de repartir unidades a una
# tienda que nunca las tuvo:
#
#   INVENTORY_MIGRATION_BRANCHES = {'mi-empresa': 'Tienda principal'}
#
# Que se detenga es el comportamiento correcto, no un fallo.
