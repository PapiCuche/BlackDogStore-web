# ============================================================
# BLACK DOG STORE — Example environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit your real .env to version control.
# ============================================================

# ---- Django core ----
# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-dev-only

# Set to 0 (False) in production
DEBUG=1

# Comma-separated list of allowed hostnames
# Dev: localhost,127.0.0.1
# Prod: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Dev: SQLite is used automatically when DATABASE_URL is not set
# Prod (Docker): postgres://postgres:postgres@db:5432/blackdog
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blackdog

# ---- CORS (required only when DEBUG=0) ----
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Stripe ----
# Use test keys (sk_test_...) for development
# NEVER commit real sk_live_... keys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Currency for Stripe charges — MUST match displayed prices
# Peru uses PEN (Peruvian Sol / S/)
STRIPE_CURRENCY=pen

# Your frontend domain — used for Stripe success/cancel redirect URLs
STRIPE_DOMAIN=http://localhost:3000

# ---- JWT Cookies (Phase 2.1) ----
# Cookie names (defaults shown — only change if you have naming conflicts)
# JWT_COOKIE_ACCESS_NAME=blackdog_access
# JWT_COOKIE_REFRESH_NAME=blackdog_refresh
# SameSite policy: Lax (recommended), Strict, or None (requires Secure=True + HTTPS)
# JWT_COOKIE_SAMESITE=Lax

# ---- CSRF Trusted Origins (required when frontend and backend are on different origins) ----
# Dev default: http://localhost:3000,http://localhost:3002
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ---- Email (Phase 2.3) ----
# Development: emails go to console stdout (no SMTP required)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Black Dog Store <no-reply@blackdogstoreperu.online>

# Frontend URL used to build links in emails (e.g. verification, reset)
FRONTEND_URL=http://localhost:3000

# Set to True to require email verification before login
# When True: new users are inactive until they click the link in the verification email
REQUIRE_EMAIL_VERIFICATION=False

# ---- SMTP (production only — set EMAIL_BACKEND below to use) ----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_smtp_password_here
# EMAIL_USE_TLS=True

# ---- HTTPS (production only, ignored when DEBUG=1) ----
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
