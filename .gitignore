# Any variant of an environment file (.env.local, .env.staging, .env.production.bak).
# The examples are the only ones that belong in the repository.
.env.*
!.env.example
!.env.production.example
# Fiscal secrets: certificate containers and the local SUNAT env live OUTSIDE
# the repo (~/.blackdog-secrets/). These are defensive so a stray copy in the
# tree is never committed. NOT a global *.pem: legitimate public certs/fixtures
# may need versioning.
*.p12
*.pfx
sunat.env
.blackdog-secrets/
.DS_Store
/.next
/dist
env.local
*.log
coverage/
.pytest_cache/

# Local databases, their write-ahead files, and dumps taken by hand.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.sql
*.sql.gz
*.dump
# Private keys. (*.pem stays versionable: see the note above.)
*.key

# Production secrets and local backups never enter the repo.
.env.production
deploy/.env.production
backups/
# Stored files: service evidence photos and shop images. They are data, some of
# it private, and must never be committed.
backend/private-media/
# The print agent's real configuration carries its token; its journal is local state.
backend/print_agent/config.json
print-agent-journal.json
print-agent-journal.json.tmp

# The previous frontend, archived on disk before the V3 integration. The durable
