# (lleva su token), copias y volcados.
*.p12
*.pfx
*.pem
*.key
sunat.env
print_agent/config.json
print-agent-journal.json*
backups/
*.log
*.sql
*.sql.gz
*.dump
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
